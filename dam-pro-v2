  const results=[];
  employees.forEach(emp=>{if(emp.name.toLowerCase().includes(query)||emp.role?.toLowerCase().includes(query))results.push({type:'Employee',name:emp.name,detail:emp.role||emp.contract_type||'',action:()=>editEmpModal(emp.id)});});
  attendance.forEach(r=>{const emp=employees.find(e=>e.id===r.employee_id);if(!emp)return;const s=`${emp.name} ${r.date} ${r.status} ${r.notes||''}`.toLowerCase();if(s.includes(query))results.push({type:'Attendance',name:emp.name,detail:`${fmtDate(r.date)} — ${STATUSES.find(st=>st.c===r.status)?.l||r.status}`,action:()=>jumpToMark(r.date)});});
