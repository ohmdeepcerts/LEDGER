    <td><div class="tc" id="tc-${row.id}">${tagsHtml}</div></td>
    <td><input type="number" class="shi amt-i" placeholder="0.00" step="0.01" min="0" value="${row.amount===0?'':row.amount}" ${isEx?'disabled':''} oninput="updateExp('${row.id}','amount',parseFloat(this.value)||0)" onblur="renderLedger()"></td>
    <td class="run-t">${C}${running.toFixed(2)}</td>
    <td style="text-align:center;"><button class="ra-btn del" onclick="deleteLedRow('${row.id}')" title="Delete"><i class="fa-solid fa-trash-alt"></i></button></td>
