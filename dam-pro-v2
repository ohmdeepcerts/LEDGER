      <i class="fa-solid fa-building-columns" style="color:var(--tel);font-size:9px;"></i>
      <span style="${bankDone?'color:var(--grn);font-weight:700;':''}">Bank ${bankDone?'✓':''} ${C}${bankPaid.toFixed(2)}</span>
      ${bankPending>0&&bankDone?`<span style="color:var(--red);font-size:10px;">-${C}${bankPending.toFixed(2)} pending</span>`:''}
    </div>
    <div style="display:flex;align-items:center;gap:5px;margin-left:17px;">
      <span style="color:var(--txtm);font-size:10px;">Custom amt:</span>
      <input type="number" step="0.01" placeholder="${bankAmt.toFixed(2)}" value="${st.bank_custom!=null?st.bank_custom:''}" style="width:70px;padding:2px 5px;border:1px solid var(--bdr);border-radius:4px;font-size:10px;background:var(--card);color:var(--txt);" onchange="setCustomPay('${empId}',${m},${y},'bank',this.value,${bankAmt},${cashAmt})">
    </div>`:''}
    ${cashAmt>0?`<div style="display:flex;align-items:center;gap:5px;">
      <input type="checkbox" id="cpay-${empId}" ${cashDone?'checked':''} onchange="markPaid('${empId}',${m},${y},'cash',this.checked,${bankAmt},${cashAmt})">
      <i class="fa-solid fa-money-bill-wave" style="color:var(--grn);font-size:9px;"></i>
      <span style="${cashDone?'color:var(--grn);font-weight:700;':''}">Cash ${cashDone?'✓':''} ${C}${cashPaid.toFixed(2)}</span>
      ${cashPending>0&&cashDone?`<span style="color:var(--red);font-size:10px;">-${C}${cashPending.toFixed(2)} pending</span>`:''}
    </div>
    <div style="display:flex;align-items:center;gap:5px;margin-left:17px;">
      <span style="color:var(--txtm);font-size:10px;">Custom amt:</span>
      <input type="number" step="0.01" placeholder="${cashAmt.toFixed(2)}" value="${st.cash_custom!=null?st.cash_custom:''}" style="width:70px;padding:2px 5px;border:1px solid var(--bdr);border-radius:4px;font-size:10px;background:var(--card);color:var(--txt);" onchange="setCustomPay('${empId}',${m},${y},'cash',this.value,${bankAmt},${cashAmt})">
    </div>`:''}
    ${allDone?`<span style="color:var(--grn);font-size:10px;font-weight:700;"><i class="fa-solid fa-circle-check"></i> Fully Paid</span>`:''}
  </div>`;
}

async function setCustomPay(empId,m,y,type,val,bankAmt,cashAmt){
  const key=`${empId}_${m}_${y}`;
  if(!paymentStatuses[key])paymentStatuses[key]={bank_paid:false,cash_paid:false,bank_custom:null,cash_custom:null};
  paymentStatuses[key][type+'_custom']=val?parseFloat(val):null;
  await sb.from('payment_status').upsert({
    employee_id:empId,month:m,year:y,
    bank_paid:paymentStatuses[key].bank_paid,
    cash_paid:paymentStatuses[key].cash_paid,
    bank_custom:paymentStatuses[key].bank_custom,
    cash_custom:paymentStatuses[key].cash_custom
  },{onConflict:'employee_id,month,year'});
  // Refresh cell
  const cell=document.getElementById(`pst-${empId}-${m}-${y}`);
  if(cell)cell.innerHTML=renderPayStatus(empId,m,y,bankAmt+cashAmt+paymentStatuses[key].bank_custom+paymentStatuses[key].cash_custom,bankAmt,cashAmt,cur());
}

async function markPaid(empId,m,y,type,checked,bankAmt,cashAmt){
  const key=`${empId}_${m}_${y}`;
  if(!paymentStatuses[key])paymentStatuses[key]={bank_paid:false,cash_paid:false,paid_at:null};
  paymentStatuses[key][type+'_paid']=checked;
  if(checked)paymentStatuses[key].paid_at=new Date().toISOString();
  // Persist to Supabase
  await sb.from('payment_status').upsert({
    employee_id:empId,month:m,year:y,
    bank_paid:paymentStatuses[key].bank_paid,
    cash_paid:paymentStatuses[key].cash_paid,
    paid_at:paymentStatuses[key].paid_at,
    bank_custom:paymentStatuses[key].bank_custom||null,
    cash_custom:paymentStatuses[key].cash_custom||null
  },{onConflict:'employee_id,month,year'});
  // Refresh cell using passed bankAmt/cashAmt
  const cell=document.getElementById(`pst-${empId}-${m}-${y}`);
  if(cell){
    const bA=bankAmt||0,cA=cashAmt||0;
    cell.innerHTML=renderPayStatus(empId,m,y,bA+cA,bA,cA,cur());
  }
  if(checked){
    const emp=employees.find(e=>e.id===empId);
    toast(`${emp?.name||''} — ${type==='bank'?'Bank transfer':'Cash payment'} marked ✓`,'s');
  }
}

async function loadPaymentStatuses(m,y){
  const r=await sb.from('payment_status').select('*').eq('month',m).eq('year',y);
  if(r.error)return;
  (r.data||[]).forEach(row=>{
    paymentStatuses[`${row.employee_id}_${m}_${y}`]={bank_paid:row.bank_paid,cash_paid:row.cash_paid,paid_at:row.paid_at,bank_custom:row.bank_custom,cash_custom:row.cash_custom};
  });
}

// ═══════════════════════════════════════════════════
// DOCUMENT VIEWER
// ═══════════════════════════════════════════════════
let _dvmDocId=null,_dvmEmpId=null;

function openDocViewer(docId){
  const doc=employeeDocuments.find(d=>d.id===docId);
  if(!doc)return;
  const emp=employees.find(e=>e.id===doc.employee_id);
  const def=DOC_TYPES[doc.doc_type]||{icon:'fa-file',color:'#64748b'};
  const st=getDocStatus(doc);
  _dvmDocId=docId;_dvmEmpId=doc.employee_id;

  document.getElementById('dvmTitle').textContent=doc.name;
  document.getElementById('dvmEmpName').textContent=emp?.name||'';
  document.getElementById('dvmDocName').textContent=doc.name;
  document.getElementById('dvmDocType').textContent=doc.doc_type?.replace(/_/g,' ')||'Document';
  document.getElementById('dvmIcon').style.cssText=`width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;background:${def.color}18;color:${def.color};`;
  document.getElementById('dvmIcon').innerHTML=`<i class="fa-solid ${def.icon}"></i>`;
  document.getElementById('dvmExpiry').textContent=doc.expiry_date?fmtDate(doc.expiry_date):'No expiry';
  document.getElementById('dvmStatus').innerHTML=doc.expiry_date?`<span style="color:${st.color};">${st.label}</span>`:'<span style="color:var(--txtm);">No expiry set</span>';
  document.getElementById('dvmReminder').textContent=doc.reminder_days?`${doc.reminder_days} days before`:'30 days before';
  document.getElementById('dvmNotes').textContent=doc.notes||'—';
  document.getElementById('dvmDeleteBtn').onclick=()=>deleteDocFromViewer(docId,doc.employee_id);

  // File display
  const fileSection=document.getElementById('dvmFileSection');
  const noFile=document.getElementById('dvmNoFile');
  const frame=document.getElementById('dvmFrame');
  const img=document.getElementById('dvmImg');
  const dlBtn=document.getElementById('dvmDownload');

  if(doc.file_url){
    fileSection.style.display='block';
    noFile.style.display='none';
    dlBtn.href=doc.file_url;
    const isImg=/\.(jpg|jpeg|png|gif|webp)/i.test(doc.file_url)||/\.(jpg|jpeg|png|gif|webp)/i.test(doc.file_name||'');
    const isPdf=/\.pdf/i.test(doc.file_url)||/\.pdf/i.test(doc.file_name||'');
    if(isImg){img.src=doc.file_url;img.style.display='block';frame.style.display='none';}
    else if(isPdf){frame.src=doc.file_url;frame.style.display='block';img.style.display='none';}
    else{img.style.display='none';frame.style.display='none';dlBtn.innerHTML='<i class="fa-solid fa-download"></i>Download file';}
  }else{
    fileSection.style.display='none';
    noFile.style.display='block';
  }
  document.getElementById('docViewModal').classList.add('open');
}

async function deleteDocFromViewer(docId,empId){
  if(!confirm('Delete this document?'))return;
  document.getElementById('docViewModal').classList.remove('open');
  await deleteDoc(docId);
}

function dvmGoToEmployee(){
  document.getElementById('docViewModal').classList.remove('open');
  if(_dvmEmpId)openDocForEmp(_dvmEmpId);
}

