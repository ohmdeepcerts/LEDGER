async function loadAllData(){
  setSyncStatus('saving');
  try{
    const [empR,cfgR,attR,expR,batR,msgR,docR,salR]=await Promise.all([
      sb.from('employees').select('*').order('name'),
      sb.from('settings').select('*').eq('id',1).single(),
      sb.from('attendance').select('*').order('date',{ascending:false}),
      sb.from('expenses').select('*').order('date',{ascending:false}),
      sb.from('expense_batches').select('*').order('submitted_at',{ascending:false}),
      sb.from('messages').select('*').order('created_at'),
      sb.from('employee_documents').select('*').order('uploaded_at',{ascending:false}),
      sb.from('salary_history').select('*').order('effective_from',{ascending:false})
    ]);
    if(empR.error)throw empR.error;
    employees=empR.data||[];
    cfg=cfgR.data||{};
    attendance=attR.data||[];
    expenses=expR.data||[];
    batches=batR.data||[];
    messages=msgR.data||[];
    employeeDocuments=docR.error?[]:docR.data||[];
    salaryHistory=salR.error?[]:salR.data||[];
    setSyncStatus('saved');
    initSelectors();
    navigate('dashboard');
    updateBadges();
    loadAllDocs(); // load document reminders
  }catch(e){
    setSyncStatus('err');
    console.error('Load error:',e);
    toast('Error loading data: '+e.message,'e');
  }
}

async function sbInsert(table,data){
  setSyncStatus('saving');
  const r=await sb.from(table).insert(data).select().single();
  if(r.error){setSyncStatus('err');toast(r.error.message,'e');return null;}
  setSyncStatus('saved');return r.data;
}
async function sbUpdate(table,id,data){
  setSyncStatus('saving');
  const r=await sb.from(table).update(data).eq('id',id);
  if(r.error){setSyncStatus('err');toast(r.error.message,'e');return false;}
  setSyncStatus('saved');return true;
}
async function sbUpsertAtt(rec){
  setSyncStatus('saving');
  const r=await sb.from('attendance').upsert(rec,{onConflict:'employee_id,date'});
  if(r.error){setSyncStatus('err');console.error('Att upsert:',r.error);return false;}
  setSyncStatus('saved');return true;
}
async function sbDelete(table,id){
  setSyncStatus('saving');
  const r=await sb.from(table).delete().eq('id',id);
  if(r.error){setSyncStatus('err');toast(r.error.message,'e');return false;}
  setSyncStatus('saved');return true;
}
async function sbUpsertSettings(data){
  setSyncStatus('saving');
  const r=await sb.from('settings').upsert({id:1,...data});
  if(r.error){setSyncStatus('err');toast(r.error.message,'e');return false;}
  cfg={...cfg,...data};setSyncStatus('saved');return true;
}

