  else{sunCard.style.display='block';document.getElementById('erSunList').innerHTML=`<p style="font-size:13px;color:var(--txt2);margin-bottom:7px;">Worked <strong style="color:#4338ca;">${suns.length} Sunday${suns.length>1?'s':''}</strong></p><div style="display:flex;flex-wrap:wrap;gap:5px;">${suns.map(r=>`<span style="background:#e0e7ff;color:#4338ca;font-size:12px;font-weight:600;padding:3px 9px;border-radius:6px;">${fmtDate(r.date)} · ${r.hours||'?'}h</span>`).join('')}</div>`;}
  let rows='';
