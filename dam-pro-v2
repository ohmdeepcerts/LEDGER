function renderEmployees(){
  const emps=empTabFilter==='all'?employees:employees.filter(e=>e.status===empTabFilter);
  const active=employees.filter(e=>e.status==='Active').length,ex=employees.filter(e=>e.status==='ex').length;
  document.getElementById('empCount').textContent=`${active} active · ${ex} ex-employees`;
  const grid=document.getElementById('empGrid'),empty=document.getElementById('empEmpty');
  if(!emps.length){grid.innerHTML='';empty.style.display='block';return;}
  empty.style.display='none';
  const C=cur();
  grid.innerHTML=emps.map(emp=>{
    const att=attendance.filter(r=>r.employee_id===emp.id);
    const wdR=att.filter(r=>isWD(new Date(r.date+'T00:00:00')));
    const pWD=wdR.filter(r=>isP(r.status)).length;
    const pct=wdR.length>0?Math.round(pWD/wdR.length*100):0;
    const suns=att.filter(r=>isSun(new Date(r.date+'T00:00:00'))&&isP(r.status)).length;
    const isEx=emp.status==='ex';
    const pt=emp.pay_type||'hourly';
    const payLabel=pt==='fixed'?`${C}${parseFloat(emp.salary||0).toFixed(0)}/mo`:pt==='daily'?`${C}${parseFloat(emp.daily_rate||0).toFixed(0)}/day`:`${C}${parseFloat(emp.hourly_rate||0).toFixed(2)}/h`;
    const hasRate=(pt==='fixed'&&emp.salary)||(pt==='daily'&&emp.daily_rate)||emp.hourly_rate;
    return`<div class="ec${isEx?' ex':''}" onclick="editEmpModal('${emp.id}')">
      <div class="ec-ava" style="background:${isEx?'linear-gradient(135deg,#7c3aed,#4c1d95)':avcol(emp.id)}">${inits(emp.name)}</div>
      <div class="ec-name">${emp.name}</div>
      <div class="ec-meta">${emp.role||'No role set'} ${emp.contract_type?`<span class="cp ${emp.contract_type==='PAYE'?'cp-p':'cp-s'}">${emp.contract_type}</span>`:''}</div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
        <span class="sp ${isEx?'sp-ex':'sp-a'}">${isEx?'● Ex':'● Active'}</span>
        ${hasRate?`<span style="font-size:10px;color:var(--grn);font-weight:700;">${payLabel}</span>`:''}
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;margin-bottom:7px;text-align:center;">
        <div style="font-size:10px;color:var(--txtm);">Present<br><strong style="font-size:14px;color:var(--grn);">${pWD}</strong></div>
        <div style="font-size:10px;color:var(--txtm);">Sundays<br><strong style="font-size:14px;color:#4338ca;">${suns}</strong></div>
        <div style="font-size:10px;color:var(--txtm);">Rate<br><strong style="font-size:14px;color:${pct>=80?'var(--grn)':pct>=60?'var(--amb)':'var(--red)'};">${pct}%</strong></div>
      </div>
      <button onclick="event.stopPropagation();${isEx?`markEmpActive('${emp.id}')`:`markEmpEx('${emp.id}')`}" style="width:100%;padding:4px;border:1px solid ${isEx?'var(--pur)':'var(--bdr)'};border-radius:5px;font-size:11px;color:${isEx?'var(--pur)':'var(--txtm)'};background:${isEx?'var(--purl)':'transparent'};cursor:pointer;"><i class="fa-solid ${isEx?'fa-user-check':'fa-user-slash'}" style="margin-right:3px;"></i>${isEx?'Reinstate':'Mark as Ex-Employee'}</button>
    </div>`;
  }).join('');
}
