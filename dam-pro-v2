function toast(msg,type='i'){
  const ic={s:'fa-circle-check',e:'fa-circle-xmark',i:'fa-circle-info'};
  const t=document.createElement('div');t.className=`toast ${type}`;
  t.innerHTML=`<i class="fa-solid ${ic[type]||ic.i}"></i>${msg}`;
  document.getElementById('toasts').appendChild(t);
  setTimeout(()=>t.remove(),3500);
}
function calcHours(si,so){
  if(!si||!so)return null;
  const[ih,im]=si.split(':').map(Number),[oh,om]=so.split(':').map(Number);
  let mins=(oh*60+om)-(ih*60+im);if(mins<0)mins+=1440;
  return parseFloat((mins/60).toFixed(1));
}
function calcOT(h,emp){
  // Always calculate OT HOURS based on threshold.
  // Whether those hours are PAID is determined by calcPay separately.
  // This means OT column shows informational hours even at £0/h.
  const v=parseFloat(h)||0;
  if(!emp)return 0;
  // OT threshold: employee's own → global → 8h default
  const t=emp.ot_threshold!=null&&emp.ot_threshold!==''&&parseFloat(emp.ot_threshold)>0
    ?parseFloat(emp.ot_threshold)
    :(parseFloat(cfg.ot_threshold)||8);
  return v>t?parseFloat((v-t).toFixed(1)):0;
}
function calcPay(emp,rec){
  const pt=emp.pay_type||'hourly';
  const dt=new Date(rec.date+'T00:00:00');
  // Weekend multipliers: use sat/sun mult if set, default 1.0
  const satM=isSat(dt)?(emp.sat_mult!=null&&emp.sat_mult!==''?parseFloat(emp.sat_mult):1):1;
  const sunM=isSun(dt)?(emp.sun_mult!=null&&emp.sun_mult!==''?parseFloat(emp.sun_mult):1):1;
  const wkM=sunM>1?sunM:satM>1?satM:1;
  const ot=parseFloat(rec.overtime)||0;

  // OT Rate: 0 mult/flat = OT hours tracked but paid £0
  let otRate=0;
  if(emp.ot_type==='flat'){
    // Flat rate: use value directly (can be 0 = unpaid OT)
    otRate=emp.ot_flat!=null&&emp.ot_flat!==''?parseFloat(emp.ot_flat):0;
  } else {
    // Multiplier mode
    const hasOwnMult=emp.ot_mult!=null&&emp.ot_mult!=='';
    let otM;
    if(hasOwnMult){
      otM=parseFloat(emp.ot_mult); // 0 = track hours, pay £0
    } else if(pt==='daily'){
      otM=0; // daily wage default: track OT hours, pay £0 unless set
    } else {
      otM=parseFloat(cfg.rate_ot)||1.5; // hourly/fixed: use global default
    }
    if(otM>0){
      let bh=0;
      if(pt==='hourly')bh=parseFloat(emp.hourly_rate)||0;
      else if(pt==='daily'){const ch=parseFloat(emp.contracted_hours)||8;bh=ch>0?(parseFloat(emp.daily_rate)||0)/ch:0;}
      else if(pt==='fixed'){const ch=parseFloat(emp.contracted_hours)||8;bh=ch>0?((parseFloat(emp.salary)||0)/30)/ch:0;}
      otRate=bh*otM;
    }
  }
  const otPay=parseFloat((ot*otRate).toFixed(2));

  // Base pay
  let basePay=0;
  if(pt==='hourly'){
    const r=parseFloat(emp.hourly_rate)||0;
    const h=parseFloat(rec.hours)||0;
    const regularH=Math.max(0,h-ot); // hours not counting OT
    basePay=parseFloat((regularH*r*wkM).toFixed(2));
  } else if(pt==='daily'){
    const r=parseFloat(emp.daily_rate)||0;
    const dayPay=rec.status==='HD'?r*0.5:r;
    basePay=parseFloat((dayPay*wkM).toFixed(2));
  } else if(pt==='fixed'){
    // Fixed salary: base pay is 0 per-record (shown as monthly lump)
    basePay=0;
  }

  return{base:basePay,ot:otPay,total:basePay+otPay};
}

