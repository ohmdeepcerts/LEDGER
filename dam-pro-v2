function qMark(empId,status){
  _touched.add(empId);
  const sSel=document.getElementById(`st-${empId}`);if(sSel){sSel.value=status;sSel.style.color='';sSel.style.fontStyle='';}
  const row=document.getElementById(`mr-${empId}`);
  if(row){row.style.opacity='1';row.querySelectorAll('.qd').forEach(d=>d.classList.remove('active'));row.querySelector(`.qd-${['P','A','HD'].includes(status)?status:'m'}`)?.classList.add('active');}
  const si=document.getElementById(`si-${empId}`),so=document.getElementById(`so-${empId}`);
  if(isP(status)){if(si&&!si.value)si.value=si.dataset.default;if(so&&!so.value)so.value=so.dataset.default;if(status==='HD'&&si?.value){const[h,m]=si.value.split(':').map(Number),t=(h*60+m)+240;so.value=String(Math.min(Math.floor(t/60),23)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');}}
  else if(['A','UL'].includes(status)){if(si)si.value='';if(so)so.value='';}
  recalcHOT(empId);
  deb('att-save',()=>saveAttSilent(),1500);
}
function tMore(id){const s=document.getElementById(`st-${id}`);if(s){s.focus();s.size=8;setTimeout(()=>s.size=1,3000);}}
function onMC(el){
  const empId=el.dataset.eid,field=el.dataset.f;
  _touched.add(empId);
  if(field==='sign_in'||field==='sign_out')recalcHOT(empId);
  if(field==='status'){
    const row=document.getElementById(`mr-${empId}`);
    if(row){
      if(el.value){row.style.opacity='1';el.style.color='';el.style.fontStyle='';}
      else{row.style.opacity='0.65';el.style.color='var(--txtm)';el.style.fontStyle='italic';}
      row.querySelectorAll('.qd').forEach(d=>d.classList.remove('active'));
      if(el.value==='P')row.querySelector('.qd-P')?.classList.add('active');
      else if(el.value==='A')row.querySelector('.qd-A')?.classList.add('active');
      else if(el.value==='HD')row.querySelector('.qd-HD')?.classList.add('active');
      else if(el.value)row.querySelector('.qd-m')?.classList.add('active');
    }
  }
  deb('att-save',()=>saveAttSilent(),1500);
}
function recalcHOT(empId){
  const si=document.getElementById(`si-${empId}`),so=document.getElementById(`so-${empId}`);
  const hEl=document.getElementById(`hr-${empId}`),otEl=document.getElementById(`ot-${empId}`);
  if(si&&so&&si.value&&so.value){
    const h=calcHours(si.value,so.value);
    if(hEl)hEl.value=h;
    const emp=employees.find(e=>e.id===empId);
    const ot=calcOT(h,emp);
    if(otEl&&ot>0)otEl.value=ot;
  }
}
async function saveAttSilent(){
  if(_touched.size===0)return;
  const key=dateKey(markDate);
  const isLocked=(cfg.locked_months||[]).includes(`${markDate.getFullYear()}_${markDate.getMonth()}`);
  if(isLocked)return;
  const toSave=[];
  _touched.forEach(empId=>{
    const row=document.getElementById(`mr-${empId}`);if(!row)return;
    const g=f=>row.querySelector(`[data-f="${f}"]`)?.value||null;
    const status=g('status');if(!status)return;
    const h=g('hours'),ot=g('overtime');
    toSave.push({employee_id:empId,date:key,status,sign_in:g('sign_in')||null,sign_out:g('sign_out')||null,hours:h?parseFloat(h):null,overtime:ot?parseFloat(ot):null,bonus:g('bonus')?parseFloat(g('bonus')):null,jobs:g('jobs')?parseInt(g('jobs')):null,notes:g('notes')||null});
  });
  if(toSave.length===0)return;
  setSyncStatus('saving');
  const results=await Promise.all(toSave.map(r=>sb.from('attendance').upsert(r,{onConflict:'employee_id,date'}).select().single()));
  const hasErr=results.some(r=>r.error);
  if(hasErr){setSyncStatus('err');console.error('Att save errors:',results.filter(r=>r.error).map(r=>r.error));return;}
  // Update local state
  results.forEach(r=>{if(!r.data)return;const idx=attendance.findIndex(a=>a.employee_id===r.data.employee_id&&a.date===r.data.date);if(idx>=0)attendance[idx]=r.data;else attendance.push(r.data);});
  setSyncStatus('saved');
}
async function saveAllAttendance(){
  const isLocked=(cfg.locked_months||[]).includes(`${markDate.getFullYear()}_${markDate.getMonth()}`);
  if(isLocked){toast(`${MONTHS[markDate.getMonth()]} ${markDate.getFullYear()} is locked`,'e');return;}
  const key=dateKey(markDate);const toSave=[];
  document.querySelectorAll('#markBody tr').forEach(row=>{
    const empId=row.querySelector('[data-eid]')?.dataset.eid;if(!empId)return;
    const g=f=>row.querySelector(`[data-f="${f}"]`)?.value||null;
    const status=g('status');if(!status)return;
    const h=g('hours'),ot=g('overtime');
    toSave.push({employee_id:empId,date:key,status,sign_in:g('sign_in')||null,sign_out:g('sign_out')||null,hours:h?parseFloat(h):null,overtime:ot?parseFloat(ot):null,bonus:g('bonus')?parseFloat(g('bonus')):null,jobs:g('jobs')?parseInt(g('jobs')):null,notes:g('notes')||null});
  });
  if(toSave.length===0){toast('Nothing to save','i');return;}
  setSyncStatus('saving');
  const results=await Promise.all(toSave.map(r=>sb.from('attendance').upsert(r,{onConflict:'employee_id,date'}).select().single()));
  const hasErr=results.some(r=>r.error);
  if(hasErr){setSyncStatus('err');toast('Some records failed to save','e');console.error(results.filter(r=>r.error));return;}
  results.forEach(r=>{if(!r.data)return;const idx=attendance.findIndex(a=>a.employee_id===r.data.employee_id&&a.date===r.data.date);if(idx>=0)attendance[idx]=r.data;else attendance.push(r.data);});
  _touched.clear();setSyncStatus('saved');toast('Attendance saved!','s');
}
function markAll(status){employees.filter(e=>e.status==='Active').forEach(e=>{_touched.add(e.id);qMark(e.id,status);});}
async function clearDay(){
  if(!confirm('Clear all attendance for this day?'))return;
  const key=dateKey(markDate);
  const r=await sb.from('attendance').delete().eq('date',key);
  if(r.error){toast(r.error.message,'e');return;}
  attendance=attendance.filter(a=>a.date!==key);
  _touched.clear();buildMarkTable();toast('Day cleared','i');
}
function shiftMark(n){_touched.clear();markDate=new Date(markDate);markDate.setDate(markDate.getDate()+n);updateMarkNav();buildMarkTable();}
function setMarkToday(){_touched.clear();markDate=new Date();updateMarkNav();buildMarkTable();}
function setMarkDate(v){_touched.clear();markDate=new Date(v+'T00:00:00');updateMarkNav();buildMarkTable();}
function jumpToMark(d){markDate=new Date(d+'T00:00:00');navigate('mark');}
