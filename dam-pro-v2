  const sortedCats=Object.entries(catT).sort((a,b)=>b[1]-a[1]);
  panel.innerHTML=`<div style="margin-bottom:14px;"><div style="font-size:11px;font-weight:700;color:var(--txtm);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Month Summary</div><div style="font-size:26px;font-weight:800;color:var(--grn);font-family:'JetBrains Mono',monospace;">${C}${total.toFixed(2)}</div><div style="font-size:12px;color:var(--txtm);">${data.length} entries</div></div>
