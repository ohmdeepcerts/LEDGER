document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key==='s'){e.preventDefault();if(currentPage==='mark')saveAllAttendance();else if(currentPage==='settings')saveSettings();}
  if(e.key==='Escape'){document.querySelectorAll('.mo.open').forEach(m=>m.classList.remove('open'));}
});
document.getElementById('empModal').addEventListener('click',function(e){if(e.target===this)closeEmpModal();});
document.getElementById('adminPin').addEventListener('keydown',e=>{if(e.key==='Enter')doAdminLogin();});
