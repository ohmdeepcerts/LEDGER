function buildTagsCell(tags,expId){
  const allTags=getAllTags();let html='';
  (tags||[]).forEach(t=>{const def=getTagDef(t);const col=def?.color||'#4f46e5';html+=`<span class="tag-chip" style="background:${h2rgba(col,0.15)};color:${col};" onclick="toggleTag('${expId}','${t}')">${t} <span style="opacity:0.5;">×</span></span>`;});
  html+=`<button class="add-tag" onclick="openTagPicker(event,'${expId}')" title="Add tag"><i class="fa-solid fa-plus" style="font-size:0.6rem;"></i></button>`;
  return html;
}
function getAllTags(){const custom=cfg.tags||[];if(!custom.find(t=>(t.name||t)==='VAT'))return[{name:'VAT',color:'#d97706'},...custom.map(t=>typeof t==='string'?{name:t,color:'#4f46e5'}:t)];return custom.map(t=>typeof t==='string'?{name:t,color:'#4f46e5'}:t);}
function getTagDef(name){if(name==='VAT')return{name:'VAT',color:'#d97706'};return(cfg.tags||[]).find(t=>(t.name||t)===name)||{name,color:'#4f46e5'};}
function h2rgba(hex,alpha){if(!hex||hex.length<7)return`rgba(79,70,229,${alpha})`;const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);return`rgba(${r},${g},${b},${alpha})`;}
function getCatStyle(cat){if(!cat)return'';let hash=0;for(let i=0;i<cat.length;i++)hash=cat.charCodeAt(i)+((hash<<5)-hash);const h=Math.abs(hash%360);return`background:hsl(${h},85%,94%);color:hsl(${h},80%,25%);border:1px solid hsl(${h},60%,85%);`;}
function openTagPicker(e,expId){
  e.stopPropagation();
  if(_activeTagPicker){_activeTagPicker.style.display='none';_activeTagPicker=null;}
  const exp=expenses.find(ex=>ex.id===expId);const currentTags=exp?.tags||[];
  const picker=document.getElementById('ledTagPicker');
  picker.innerHTML=`<div class="tp-title">Apply Tags</div><div id="tpc"></div>`;
  const chips=picker.querySelector('#tpc');
  getAllTags().forEach(tag=>{const isOn=currentTags.includes(tag.name);const bg=h2rgba(tag.color,0.12);const chip=document.createElement('div');chip.className=`tp-chip${isOn?' on':''}`;chip.style.cssText=`background:${bg};color:${tag.color};border-color:${h2rgba(tag.color,0.4)};`;chip.innerHTML=`<span style="width:7px;height:7px;border-radius:50%;background:${tag.color};display:inline-block;"></span>${tag.name}${isOn?' ✓':''}`;chip.onclick=()=>{toggleTag(expId,tag.name);picker.style.display='none';};chips.appendChild(chip);});
  const rect=e.target.getBoundingClientRect();
  picker.style.cssText=`display:block;top:${rect.bottom+4}px;left:${Math.min(rect.left,window.innerWidth-210)}px;`;
  _activeTagPicker=picker;
}
document.addEventListener('click',()=>{if(_activeTagPicker){_activeTagPicker.style.display='none';_activeTagPicker=null;}});
async function toggleTag(expId,tagName){
  const exp=expenses.find(e=>e.id===expId);if(!exp)return;
  const tags=[...(exp.tags||[])];
  if(tags.includes(tagName)){exp.tags=tags.filter(t=>t!==tagName);}else{exp.tags=[...tags,tagName];}
  await sb.from('expenses').update({tags:exp.tags}).eq('id',expId);
  const cell=document.getElementById(`tc-${expId}`);
  if(cell)cell.innerHTML=buildTagsCell(exp.tags,expId);
  renderLedRight(expenses.filter(e=>{const d=new Date(e.date+'T00:00:00');return e.employee_id===ledgerStaff&&d.getFullYear()===ledgerYear&&String(d.getMonth()+1).padStart(2,'0')===ledgerMonth;}).sort((a,b)=>a.date.localeCompare(b.date)),cur());
}
async function updateExp(id,field,val){
  const exp=expenses.find(e=>e.id===id);if(!exp)return;
  exp[field]=val;
  deb('exp-save-'+id,async()=>{await sb.from('expenses').update({[field]:val}).eq('id',id);},900);
}
function checkAutoNextRow(rowId,rowIdx,totalRows){
  // If this is the last row and user started typing, auto-add next row
  if(rowIdx===totalRows-1){
    const el=document.getElementById(`led-m-${rowId}`)||document.querySelector(`input[data-eid="${rowId}"]`);
    deb('auto-next-'+rowId,async()=>{
      const val=document.querySelector(`#ledBody tr:last-child td:nth-child(3) input`)?.value||'';
      if(val.trim().length>0)await addLedRow();
