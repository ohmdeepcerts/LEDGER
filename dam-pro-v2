  ${sortedCats.length?`<div style="font-size:11px;font-weight:700;color:var(--txtm);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:7px;">By Category</div>${sortedCats.map(([c,v])=>{const pct=total>0?Math.round(v/total*100):0;const s=getCatStyle(c);return`<div style="margin-bottom:7px;"><div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:2px;"><span style="${s}padding:1px 6px;border-radius:4px;">${c}</span><span style="font-family:'JetBrains Mono';font-weight:600;">${C}${v.toFixed(2)}</span></div><div class="pb"><div class="pf pf-g" style="width:${pct}%"></div></div></div>`;}).join('')}`:''}
