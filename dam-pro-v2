function getDocStatus(doc){
  if(!doc.expiry_date)return{status:'none',label:'No expiry',color:'var(--txtm)'};
  const exp=new Date(doc.expiry_date+'T00:00:00');
  const now=new Date();
  const days=Math.ceil((exp-now)/(1000*60*60*24));
  const remind=doc.reminder_days||30;
  if(days<0)return{status:'expired',label:`Expired ${Math.abs(days)}d ago`,color:'var(--red)',bg:'var(--redl)'};
  if(days<=remind)return{status:'expiring',label:`Expires in ${days} days`,color:'var(--amb)',bg:'var(--ambl)'};
  return{status:'valid',label:`Valid · expires ${fmtDate(doc.expiry_date)}`,color:'var(--grn)',bg:'var(--grnl)'};
}

function renderDocReminders(){
  // Returns HTML for dashboard reminders
  const now=new Date();
  const urgent=employeeDocuments.filter(d=>{
    if(!d.expiry_date)return false;
    const exp=new Date(d.expiry_date+'T00:00:00');
    const days=Math.ceil((exp-now)/(1000*60*60*24));
    return days<=(d.reminder_days||30);
  }).sort((a,b)=>{
    const dA=new Date(a.expiry_date),dB=new Date(b.expiry_date);
    return dA-dB;
  });
  return urgent;
}



