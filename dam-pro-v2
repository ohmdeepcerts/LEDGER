}
async function addLedRow(){
  if(!ledgerStaff)return;
  const today=dateKey(new Date());
  const dateToUse=today.startsWith(`${ledgerYear}-${ledgerMonth}`)?today:`${ledgerYear}-${ledgerMonth}-01`;
  const r=await sb.from('expenses').insert({employee_id:ledgerStaff,date:dateToUse,merchant:'',category:'',amount:0,tags:[],status:'draft'}).select().single();
  if(r.error){toast(r.error.message,'e');return;}
