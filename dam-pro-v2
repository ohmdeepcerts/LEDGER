function renderMonthly(){
  const month=parseInt(document.getElementById('mvMonth').value);
  const year=parseInt(document.getElementById('mvYear').value);
  const days=dim(year,month);const emps=employees.filter(e=>e.status==='Active');
  let hRow='<thead><tr><th style="text-align:left;padding-left:9px;">Employee</th>';
  for(let d=1;d<=days;d++){const dt=new Date(year,month,d),dow=dt.getDay();const cc=(dow===0?'sc2':dow===6?'wc':'')+(dow===1?' wsc':'');hRow+=`<th class="${cc}" style="width:22px;">${d}<br><span style="font-size:7px;">${['Su','Mo','Tu','We','Th','Fr','Sa'][dow]}</span></th>`;}
  hRow+='<th>P</th><th>A</th><th>HD</th><th>☀</th><th>%</th></tr></thead>';
  let body='<tbody>';
  emps.forEach(emp=>{
    const wD=Array.from({length:days},(_,i)=>isWD(new Date(year,month,i+1))).filter(Boolean).length;
    body+=`<tr><td><span class="ava" style="background:${avcol(emp.id)};width:20px;height:20px;font-size:8px;margin-right:4px;">${inits(emp.name)}</span>${emp.name}</td>`;
    const counts={P:0,A:0,HD:0,SUN:0};
    for(let d=1;d<=days;d++){
      const dt=new Date(year,month,d),dow=dt.getDay(),sun=dow===0,sat=dow===6,mon=dow===1;
      const cc=(sun?'sc2':sat?'wc':'')+(mon?' wsc':'');
      const key=dateKey(dt),rec=attendance.find(r=>r.employee_id===emp.id&&r.date===key);
      if(rec){counts[rec.status]=(counts[rec.status]||0)+1;if(sun&&isP(rec.status))counts.SUN++;body+=`<td class="${cc}"><span class="dc ${rec.status}" title="${rec.status}">${rec.status}</span></td>`;}
      else if(sun)body+=`<td class="${cc}"><span class="dc empty" style="border-color:#c7d2fe;color:#a5b4fc;font-size:7px;">☀</span></td>`;
      else if(sat)body+=`<td class="${cc}"><span class="dc empty" style="border-color:#ddd6fe;color:#a78bfa;">·</span></td>`;
      else body+=`<td class="${cc}"><span class="dc empty">·</span></td>`;
    }
    const mR=attendance.filter(r=>r.employee_id===emp.id&&(()=>{const d=new Date(r.date+'T00:00:00');return d.getMonth()===month&&d.getFullYear()===year;})());
    const pw=mR.filter(r=>isP(r.status)&&isWD(new Date(r.date+'T00:00:00'))).length;
    const pct=wD>0?Math.round(pw/wD*100):0;const pc=pct>=80?'var(--grn)':pct>=60?'var(--amb)':'var(--red)';
    body+=`<td style="font-size:11px;font-weight:700;color:var(--grn);">${counts.P}</td><td style="font-size:11px;font-weight:700;color:var(--red);">${counts.A||0}</td><td style="font-size:11px;font-weight:700;color:var(--amb);">${counts.HD||0}</td><td style="font-size:11px;font-weight:700;color:#4338ca;">${counts.SUN}</td><td style="font-size:11px;font-weight:700;color:${pc};">${pct}%</td></tr>`;
  });
  document.getElementById('mvTable').innerHTML=hRow+body+'</tbody>';
}

