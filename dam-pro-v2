function exportPayrollCSV(){
  const m=parseInt(document.getElementById('prMonth').value),y=parseInt(document.getElementById('prYear').value);
  const emps=employees.filter(e=>e.status==='Active');
  const mRecs=attendance.filter(r=>{const d=new Date(r.date+'T00:00:00');return d.getMonth()===m&&d.getFullYear()===y;});
  const C=cur();
  const rows=[['Employee','Role','Contract','Pay Type','Days','Absent','Hrs','OT Hrs','Base Pay','OT Pay','Bonus','Expenses','Total','Bank Name','To Bank','Cash']];
  emps.forEach(emp=>{
    const recs=mRecs.filter(r=>r.employee_id===emp.id);const aR=recs.filter(r=>isP(r.status));
    const pt=emp.pay_type||'hourly';
    let base=0;if(pt==='fixed')base=parseFloat(emp.salary)||0;else aR.forEach(r=>{base+=calcPay(emp,r).base;});
    let otP=0;aR.forEach(r=>{otP+=calcPay(emp,r).ot;});
    const bonus=recs.reduce((s,r)=>s+(parseFloat(r.bonus)||0),0);
    const empExp=expenses.filter(e=>{const d=new Date(e.date+'T00:00:00');return e.employee_id===emp.id&&d.getMonth()===m&&d.getFullYear()===y;});
    const expAmt=empExp.reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
    const total=base+otP+bonus+expAmt;const bank=Math.min(parseFloat(emp.bank_amt)||0,total);
    const H=recs.reduce((s,r)=>s+(parseFloat(r.hours)||0),0),OT=recs.reduce((s,r)=>s+(parseFloat(r.overtime)||0),0);
    rows.push([emp.name,emp.role||'',emp.contract_type||'PAYE',pt,aR.length,recs.filter(r=>r.status==='A').length,H.toFixed(1),OT.toFixed(1),C+base.toFixed(2),C+otP.toFixed(2),C+bonus.toFixed(2),C+expAmt.toFixed(2),C+total.toFixed(2),emp.bank_name||'',C+bank.toFixed(2),C+Math.max(0,total-bank).toFixed(2)]);
  });
  const csv=rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,\uFEFF'+encodeURIComponent(csv);a.download=`Payroll_${MONTHS[m]}_${y}.csv`;a.click();toast('CSV downloaded!','s');
}
