function renderLedger(){
  // Staff pills
  const sp=document.getElementById('staffPills');
  if(sp){sp.innerHTML='';if(!ledgerStaff&&employees.length>0)ledgerStaff=employees[0].id;employees.forEach(e=>{const isEx=e.status==='ex';const pill=document.createElement('div');pill.className=`pill${e.id===ledgerStaff?' on':''}${isEx?' ex':''}`;pill.textContent=e.name;pill.onclick=()=>{ledgerStaff=e.id;renderLedger();};sp.appendChild(pill);});}
  // Month pills
  const mp=document.getElementById('monthPills');
  if(mp){mp.innerHTML='';MONTHS.forEach((m,i)=>{const ms=String(i+1).padStart(2,'0');const pill=document.createElement('div');pill.className=`pill${ms===ledgerMonth?' on':''}`;pill.textContent=m.slice(0,3);pill.onclick=()=>{ledgerMonth=ms;renderLedger();};mp.appendChild(pill);});}
  document.getElementById('ledgerYrDisp').textContent=ledgerYear;
  if(!ledgerStaff)return;
  const emp=employees.find(e=>e.id===ledgerStaff);if(!emp)return;
  const isEx=emp.status==='ex';
  const C=cur();
  // Filter expenses for this employee/month/year
  const data=expenses.filter(e=>{
    const d=new Date(e.date+'T00:00:00');
    return e.employee_id===ledgerStaff&&d.getFullYear()===ledgerYear&&String(d.getMonth()+1).padStart(2,'0')===ledgerMonth;
  }).sort((a,b)=>a.date.localeCompare(b.date));
  const total=data.reduce((s,r)=>s+(parseFloat(r.amount)||0),0);
  document.getElementById('ledTitle').innerHTML=`${emp.name}${isEx?` <span style="color:var(--red);font-size:0.7em;background:var(--redl);padding:1px 6px;border-radius:4px;">EX</span>`:''} | ${MONTHS[parseInt(ledgerMonth)-1]} ${ledgerYear}`;
  document.getElementById('ledTotal').textContent=C+total.toFixed(2);
  document.getElementById('ledRowCt').textContent=`${data.length} row${data.length!==1?'s':''}`;
  // Tag summary
  const tagT={};data.forEach(r=>(r.tags||[]).forEach(t=>{tagT[t]=(tagT[t]||0)+(parseFloat(r.amount)||0);}));
  document.getElementById('ledTagSum').innerHTML=Object.entries(tagT).map(([t,v])=>{const def=getTagDef(t);const col=def?.color||'#4f46e5';return`<span style="font-size:11px;font-weight:700;padding:2px 7px;border-radius:20px;background:${h2rgba(col,0.12)};color:${col};">${t} ${C}${v.toFixed(2)}</span>`;}).join('');
  // Table
  const tbody=document.getElementById('ledBody'),empty=document.getElementById('ledEmpty');
  if(data.length===0){tbody.innerHTML='';empty.style.display='block';renderLedRight(data,C);}
  else{empty.style.display='none';let running=0;tbody.innerHTML=data.map((row,i)=>{running+=(parseFloat(row.amount)||0);return buildLedRow(row,i,running,C,isEx);}).join('');}
  renderLedRight(data,C);
}
function buildLedRow(row,i,running,C,isEx){
