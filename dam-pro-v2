let isLoggedIn=false;
function getAdminPin(){return localStorage.getItem('dam_admin_pin')||'1234';}
function doAdminLogin(){
  const pin=document.getElementById('adminPin').value;
  const err=document.getElementById('authErr');
  err.style.display='none';
  if(pin===getAdminPin()){
    isLoggedIn=true;
    document.getElementById('auth-overlay').style.display='none';
    loadAllData();
  }else{
    err.textContent='Incorrect PIN. Default PIN is 1234.';
    err.style.display='block';
    document.getElementById('adminPin').value='';
  }
}
function doSignOut(){
  isLoggedIn=false;
  document.getElementById('auth-overlay').style.display='flex';
  document.getElementById('adminPin').value='';
  document.getElementById('authErr').style.display='none';
}
function changePin(){
  const np=document.getElementById('newPin').value;
  const cp=document.getElementById('confirmPin').value;
  if(np.length<4){toast('PIN must be at least 4 digits','e');return;}
  if(np!==cp){toast('PINs do not match','e');return;}
  localStorage.setItem('dam_admin_pin',np);
  document.getElementById('newPin').value='';
  document.getElementById('confirmPin').value='';
  toast('Admin PIN updated!','s');
}

