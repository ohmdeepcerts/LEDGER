const PG_TITLES={dashboard:'DASHBOARD',mark:'MARK ATTENDANCE',ledger:'EXPENSE LEDGER',approvals:'APPROVALS',tags:'TAGS & ANALYTICS',monthly:'MONTHLY VIEW',daily:'DAILY VIEW','emp-report':'EMPLOYEE REPORT',yearly:'YEARLY SUMMARY',search:'GLOBAL SEARCH',payroll:'PAYROLL',employees:'EMPLOYEES',messages:'MESSAGES',flags:'FLAGGED ITEMS',settings:'SETTINGS & TOOLS'};

function navigate(page){
  document.querySelectorAll('.page').forEach(p=>{p.classList.remove('active');if(p.classList.contains('page-lf'))p.style.display='';});
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const content=document.getElementById('mainContent');
  const pel=document.getElementById('page-'+page);
  if(pel){
    pel.classList.add('active');
    const isLF=pel.classList.contains('page-lf');
    if(isLF)pel.style.display='flex';
    if(content)content.classList.toggle('ledger-mode',isLF);
  }
  document.querySelector(`[data-page="${page}"]`)?.classList.add('active');
  document.getElementById('pgTitle').textContent=PG_TITLES[page]||page.toUpperCase();
  currentPage=page;
  if(page==='dashboard')renderDashboard();
  else if(page==='mark')renderMark();
  else if(page==='ledger')renderLedger();
  else if(page==='approvals')renderApprovals();
  else if(page==='tags')renderTags();
  else if(page==='monthly')renderMonthly();
  else if(page==='daily')renderDaily();
  else if(page==='emp-report'){populateEmpSel('erEmp');renderEmpReport();}
  else if(page==='yearly')renderYearly();
  else if(page==='search'){setTimeout(()=>document.getElementById('srchInput')?.focus(),80);}
  else if(page==='payroll')renderPayroll();
  else if(page==='employees')renderEmployees();
  else if(page==='messages')populateMsgSel();
  else if(page==='flags')renderFlags();
  else if(page==='settings')loadSettings();
}
document.querySelectorAll('.nav-item[data-page]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.page)));
function toggleSidebar(){document.getElementById('sidebar').classList.toggle('col');}
function toggleTheme(){const h=document.documentElement;h.dataset.theme=h.dataset.theme==='dark'?'light':'dark';localStorage.setItem('dam_theme',h.dataset.theme);}
(()=>document.documentElement.dataset.theme=localStorage.getItem('dam_theme')||'light')();
function handleSearch(q){if(q.trim().length>1){navigate('search');setTimeout(()=>{document.getElementById('srchInput').value=q;renderSearch(q);},60);}}
function updateBadges(){
  const pend=batches.filter(b=>b.status==='pending').length;
  const ab=document.getElementById('aprBadge');if(ab){ab.textContent=pend;ab.style.display=pend>0?'':'none';}
  const unread=messages.filter(m=>!m.read&&m.sender!=='office').length;
  const mb=document.getElementById('msgBadge');if(mb){mb.textContent=unread;mb.style.display=unread>0?'':'none';}
  const flags=expenses.filter(e=>e.flagged).length;
