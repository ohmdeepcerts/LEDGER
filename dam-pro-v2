function initSelectors(){
  populateMY('dashMonth','dashYear');populateMY('erMonth','erYear');
  populateMY('prMonth','prYear');populateMY('tagsMonth','tagsYear');
  populateYr('yrSel');populateYr('tagsYear');
  // Staff in ledger/tags/dashboard
  ['dashStaff','tagsStaff'].forEach(id=>{
    const s=document.getElementById(id);if(!s)return;
    const cur=s.value;s.innerHTML='<option value="All">All Staff</option>';
    employees.forEach(e=>{s.appendChild(new Option(e.name,e.id));});
    if(cur&&[...s.options].some(o=>o.value===cur))s.value=cur;
  });
  const msgSel=document.getElementById('msgEmpSel');
  if(msgSel){msgSel.innerHTML='<option value="">— Choose employee —</option>';employees.filter(e=>e.status==='Active').forEach(e=>{msgSel.appendChild(new Option(e.name,e.id));});}
}
function populateMY(mId,yId){
  const ms=document.getElementById(mId),ys=document.getElementById(yId);
  if(!ms||!ys||ms.options.length>0)return;
  const now=new Date();
  MONTHS.forEach((m,i)=>{const o=new Option(m,i);if(i===now.getMonth())o.selected=true;ms.appendChild(o);});
  for(let y=now.getFullYear()-3;y<=now.getFullYear()+2;y++){const o=new Option(y,y);if(y===now.getFullYear())o.selected=true;ys.appendChild(o);}
}
function populateYr(id){
  const el=document.getElementById(id);if(!el||el.options.length>0)return;const now=new Date();
  for(let y=now.getFullYear()-3;y<=now.getFullYear()+2;y++){const o=new Option(y,y);if(y===now.getFullYear())o.selected=true;el.appendChild(o);}
}
function populateEmpSel(id){
  const s=document.getElementById(id);if(!s)return;
  const cur=s.value||_lastEmpId;s.innerHTML='';
  employees.filter(e=>e.status==='Active').forEach(e=>{s.appendChild(new Option(e.name,e.id));});
  if(cur&&[...s.options].some(o=>o.value===cur))s.value=cur;
  else if(s.options.length>0)_lastEmpId=s.value;
  s.onchange=()=>{_lastEmpId=s.value;renderEmpReport();};
}
