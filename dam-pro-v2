  const wD=Array.from({length:days},(_,i)=>isWD(new Date(year,month,i+1))).filter(Boolean).length;
  const present=mRecs.filter(r=>isP(r.status)&&isWD(new Date(r.date+'T00:00:00'))).length;
  const absent=mRecs.filter(r=>r.status==='A').length;
