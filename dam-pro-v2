async function saveEmployee(){
  const name=document.getElementById('eName').value.trim().toUpperCase();
  if(!name){toast('Please enter a name','e');return;}
  const pin=document.getElementById('ePin').value;
  const pinC=document.getElementById('ePinConfirm').value;
  if(pin&&pin!==pinC){toast('PINs do not match','e');return;}
  if(pin&&pin.length<4){toast('PIN must be at least 4 digits','e');return;}
  const payType2=document.querySelector('.ptc.sel')?.id?.replace('pt-','')||'fixed';
  const bkSel=document.getElementById('eBankName').value;
  const bkName=bkSel==='custom'?document.getElementById('eBankCustom').value:bkSel;
  const data={
    name,status:document.getElementById('eStatus').value,
    role:document.getElementById('eRole').value,
    contract_type:document.getElementById('eContract').value,
    phone:document.getElementById('ePhone').value,
    join_date:document.getElementById('eJoin').value||null,
    left_date:document.getElementById('eLeft').value||null,
    notes:document.getElementById('eNotes').value,
    work_start:document.getElementById('eWStart').value,
    work_end:document.getElementById('eWEnd').value,
    pay_type:payType2,
    salary:document.getElementById('eSalary').value?parseFloat(document.getElementById('eSalary').value):null,
    contracted_hours:document.getElementById('eContHrs').value?parseFloat(document.getElementById('eContHrs').value):null,
    daily_rate:document.getElementById('eDailyRate').value?parseFloat(document.getElementById('eDailyRate').value):null,
    hourly_rate:document.getElementById('eHrRate').value?parseFloat(document.getElementById('eHrRate').value):null,
    ot_threshold:document.getElementById('eOTThr').value?parseFloat(document.getElementById('eOTThr').value):null,
    ot_type:document.getElementById('eOTType').value,
    ot_mult:document.getElementById('eOTMult').value?parseFloat(document.getElementById('eOTMult').value):null,
    ot_flat:document.getElementById('eOTFlat').value?parseFloat(document.getElementById('eOTFlat').value):null,
    sat_mult:document.getElementById('eSat').value?parseFloat(document.getElementById('eSat').value):null,
    sun_mult:document.getElementById('eSun').value?parseFloat(document.getElementById('eSun').value):null,
    bank_amt:document.getElementById('eBankAmt').value?parseFloat(document.getElementById('eBankAmt').value):null,
    bank_name:bkName||null,
    pin:pin||null
  };
  const id=document.getElementById('empId').value;
  // Try save, if schema cache error on ot_threshold retry without it
  async function trySave(d){
    if(id){
      const r=await sb.from('employees').update(d).eq('id',id).select().single();
      return r;
    }else{
      const r=await sb.from('employees').insert(d).select().single();
      return r;
    }
  }
  let r=await trySave(data);
  if(r.error&&r.error.message&&(r.error.message.includes('ot_threshold')||r.error.message.includes('column'))){
    // Schema cache issue - try without ot_threshold
    const {ot_threshold,...dataNoOT}=data;
    r=await trySave(dataNoOT);
  }
  if(r.error){toast(r.error.message,'e');return;}
  const saved=r.data;
  const prevEmp=employees.find(e=>e.id===id);

  if(id){const idx=employees.findIndex(e=>e.id===id);if(idx>=0)employees[idx]={...employees[idx],...saved};}
  else{employees.push(saved);}

  // Track salary/rate change in history
  const effectiveFrom=document.getElementById('eSalaryFrom')?.value||document.getElementById('eDailyFrom')?.value||dateKey(new Date());
  const adj=parseFloat(document.getElementById('eSalaryAdj')?.value)||0;
  const pt3=payType2;
  const newRate=pt3==='fixed'?parseFloat(document.getElementById('eSalary').value)||0:
                pt3==='daily'?parseFloat(document.getElementById('eDailyRate').value)||0:
                parseFloat(document.getElementById('eHrRate').value)||0;
  const oldRate=prevEmp?(pt3==='fixed'?parseFloat(prevEmp.salary||0):pt3==='daily'?parseFloat(prevEmp.daily_rate||0):parseFloat(prevEmp.hourly_rate||0)):0;

  if(id&&newRate!==oldRate&&newRate>0){
    // Salary changed — save to history
    const histRow={
      employee_id:saved.id,
      pay_type:pt3,
      old_rate:oldRate,
      new_rate:newRate,
      effective_from:effectiveFrom||dateKey(new Date()),
      adjustment:adj||null,
      notes:`Rate changed from ${cur()}${oldRate.toFixed(2)} to ${cur()}${newRate.toFixed(2)}`
    };
    const hr=await sb.from('salary_history').insert(histRow).select().single();
    if(!hr.error){
      salaryHistory.unshift(hr.data);
      toast(`${name} saved! Rate updated ${cur()}${oldRate.toFixed(2)} → ${cur()}${newRate.toFixed(2)} from ${effectiveFrom||'today'}.`,'s');
    } else {
      toast(`${name} saved!`,'s');
    }
  } else if(!id&&newRate>0){
    // New employee — create initial history entry
    const histRow={employee_id:saved.id,pay_type:pt3,old_rate:0,new_rate:newRate,effective_from:effectiveFrom||saved.join_date||dateKey(new Date()),notes:'Initial rate'};
    const hr=await sb.from('salary_history').insert(histRow).select().single();
    if(!hr.error)salaryHistory.unshift(hr.data);
    toast(`${name} saved!`,'s');
  } else {
    toast(`${name} saved!`,'s');
  }

  // Load salary history in modal if open
  const empIdNow=saved.id||id;
  if(empIdNow)setTimeout(()=>loadSalaryHistory(empIdNow),200);

  closeEmpModal();renderEmployees();initSelectors();
}
