async function submitBatch(){
  if(!ledgerStaff){toast('Select a staff member first','e');return;}
  const data=expenses.filter(e=>{const d=new Date(e.date+'T00:00:00');return e.employee_id===ledgerStaff&&d.getFullYear()===ledgerYear&&String(d.getMonth()+1).padStart(2,'0')===ledgerMonth;});
  const total=data.reduce((s,r)=>s+(parseFloat(r.amount)||0),0);
  if(total===0){toast('No expenses to submit','e');return;}
  const emp=employees.find(e=>e.id===ledgerStaff);
  if(!confirm(`Submit ${emp?.name} — ${MONTHS[parseInt(ledgerMonth)-1]} ${ledgerYear} (${fmt(total)}) for approval?`))return;
  // Remove existing pending batch for same period
  const existing=batches.find(b=>b.employee_id===ledgerStaff&&b.month===ledgerMonth&&b.year===ledgerYear&&b.status==='pending');
  if(existing){await sb.from('expense_batches').delete().eq('id',existing.id);batches=batches.filter(b=>b.id!==existing.id);}
  const r=await sb.from('expense_batches').insert({employee_id:ledgerStaff,month:ledgerMonth,year:ledgerYear,total,status:'pending'}).select().single();
  if(r.error){toast(r.error.message,'e');return;}
  batches.push(r.data);updateBadges();toast(`Submitted for approval`,'s');
}

