  const C=cur();
  const recOT=mRecs.filter(r=>isP(r.status)).reduce((s,r)=>s+calcPay(emp,r).ot,0);
  const totalPay=(emp.pay_type==='fixed'?parseFloat(emp.salary||0):mRecs.filter(r=>isP(r.status)).reduce((s,r)=>s+calcPay(emp,r).base,0))+recOT+totalBonus;
