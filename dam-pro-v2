  const today=dateKey(new Date());
  const dateToUse=today.startsWith(`${ledgerYear}-${ledgerMonth}`)?today:`${ledgerYear}-${ledgerMonth}-01`;
  const r=await sb.from('expenses').insert({employee_id:ledgerStaff,date:dateToUse,merchant,category,amount,tags:[],status:'draft'}).select().single();
