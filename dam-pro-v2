function renderDashboard(){
  const now=new Date();
  document.getElementById('dashDate').textContent=now.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const month=parseInt(document.getElementById('dashMonth')?.value??now.getMonth());
  const year=parseInt(document.getElementById('dashYear')?.value??now.getFullYear());
  const staffF=document.getElementById('dashStaff')?.value||'All';
  const emps=employees.filter(e=>e.status==='Active');
  const todayKey=dateKey(now);
  const todayRecs=attendance.filter(r=>r.date===todayKey);
  const days=dim(year,month);
  const wDays=Array.from({length:days},(_,i)=>isWD(new Date(year,month,i+1))).filter(Boolean).length;
  const mRecs=attendance.filter(r=>{const d=new Date(r.date+'T00:00:00');return d.getMonth()===month&&d.getFullYear()===year;});
  const presentToday=todayRecs.filter(r=>isP(r.status)).length;
  const absentToday=todayRecs.filter(r=>r.status==='A').length;
  const leaveToday=todayRecs.filter(r=>['L','S','H','UL'].includes(r.status)).length;
  const monthHrs=mRecs.reduce((s,r)=>s+(parseFloat(r.hours)||0),0);
  const mStr=String(month+1).padStart(2,'0');
  const mExpenses=expenses.filter(r=>{const d=new Date(r.date+'T00:00:00');return d.getMonth()===month&&d.getFullYear()===year&&(staffF==='All'||r.employee_id===staffF);});
  const totalExp=mExpenses.reduce((s,r)=>s+(parseFloat(r.amount)||0),0);
  const vatTotal=mExpenses.filter(r=>r.tags?.includes('VAT')).reduce((s,r)=>s+(parseFloat(r.amount)||0),0);
  const pendingCount=batches.filter(b=>b.status==='pending').length;
  let payrollEst=0;
  emps.forEach(emp=>{
    const recs=mRecs.filter(r=>r.employee_id===emp.id&&isP(r.status));
    if(emp.pay_type==='fixed')payrollEst+=parseFloat(emp.salary)||0;
    else recs.forEach(r=>{payrollEst+=calcPay(emp,r).total;});
    const empExp=expenses.filter(e=>e.employee_id===emp.id&&(()=>{const d=new Date(e.date+'T00:00:00');return d.getMonth()===month&&d.getFullYear()===year;})());
    payrollEst+=empExp.reduce((s,e)=>s+(parseFloat(e.amount)||0),0);
  });
  // Not marked
  const markedIds=new Set(todayRecs.map(r=>r.employee_id));
  const notMarked=emps.filter(e=>!markedIds.has(e.id));
  const nmCard=document.getElementById('nmCard');
